---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/media';
import { renderMarkdown } from '../lib/markdown';

const site = (await getEntry('site', 'site'))!.data;
const hero = (await getEntry('hero', 'hero'))!.data;
const about = (await getEntry('about', 'about'))!.data;
const skills = (await getEntry('skills', 'skills'))!.data;
const projectsSection = (await getEntry('projectsSection', 'projectsSection'))!.data;
const contact = (await getEntry('contact', 'contact'))!.data;

const allProjects = await getCollection('projects', ({ data }) => data.published);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const cardMetrics = (metrics: (typeof projects)[number]['data']['metrics']) =>
  metrics.filter((m) => m.placement === 'card');

const splitLines = (text: string) => text.split('\n');
---

<Layout title={site.metaTitle} description={site.metaDescription}>
  <div class="site">
    <nav id="nav">
      <div class="wrap">
        <a href={withBase('#home')} class="brand">
          <span class="mark"><span>{site.brandInitials}</span></span>
          {site.brandName}
        </a>
        <div class="navlinks">
          <a href={withBase('#home')}>Home</a>
          <a href={withBase('#about')}>About</a>
          <a href={withBase('#skills')}>Skills</a>
          <a href={withBase('#projects')}>Projects</a>
          <a href={withBase('#contact')}>Contact</a>
          {contact.cvUrl ? (
            <a class="cv-btn" href={contact.cvUrl} target="_blank" rel="noreferrer">Get CV</a>
          ) : (
            <a class="cv-btn" href={withBase('#contact')}>Get CV</a>
          )}
        </div>
      </div>
    </nav>

    <main>
      <section id="home">
        <div class="hero">
          <div class="wrap hero-grid">
            <div class="hero-copy">
              <div class="eyebrow">{hero.eyebrow}</div>
              <h1>
                {hero.titleLine1}<br />
                {hero.titleLine2}<em>{hero.titleAccent}</em>
              </h1>
              <p class="lede">{hero.lede}</p>
              <div class="hero-cta">
                <a class="btn primary" href={withBase('#projects')}>{hero.ctaPrimary}</a>
                <a class="btn" href={contact.cvUrl || withBase('#contact')} target={contact.cvUrl ? '_blank' : undefined} rel={contact.cvUrl ? 'noreferrer' : undefined}>
                  {hero.ctaSecondary}
                </a>
              </div>
              <div class="stat-strip">
                {hero.stats.map((st) => (
                  <div>
                    <b>{st.value}</b>
                    <span>{st.label}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="hero-visual">
              <div class="frame">
                {hero.image && <img src={withBase(hero.image)} alt={hero.imageAlt} />}
              </div>
              <div class="cap">
                <span>{hero.caption}</span>
                <span>{hero.captionRight}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="on-paper">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="eyebrow">{about.eyebrow}</div>
            <h2>
              {splitLines(about.title).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </h2>
          </div>
          <div class="about-grid">
            <div class="reveal" set:html={renderMarkdown(about.body)} />
            <div class="spec-card reveal">
              <div class="head">
                <span>{about.cardTitle}</span>
                <span>{about.cardRev}</span>
              </div>
              {about.specs.map((sp) => (
                <div class="spec-row">
                  <span class="k">{sp.key}</span>
                  <span class="v">{sp.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="skills" class="on-ink">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="eyebrow">{skills.eyebrow}</div>
            <h2 style="color:var(--text-ink)">
              {splitLines(skills.title).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </h2>
            <p class="text-paper-dim" style="max-width:60ch; margin-top:14px; font-size:15px">{skills.intro}</p>
          </div>
          <div class="skill-grid">
            {skills.categories.map((c) => (
              <div class="skill-card rated reveal">
                <h3>{c.title}</h3>
                <span class="sub">{c.subtitle}</span>
                {c.items.map((sk) => (
                  <div class="skill-item">
                    <div class="row">
                      <span class="name">{sk.name}</span>
                      <span class="level">{sk.level}</span>
                    </div>
                    <div class="bar">
                      <i style={`--pct: ${sk.pct}%`} />
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="projects" class="on-paper">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="eyebrow">{projectsSection.eyebrow}</div>
            <h2>
              {splitLines(projectsSection.title).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </h2>
            <p style="max-width:60ch; margin-top:14px; font-size:15px; color:var(--text-paper-dim)">{projectsSection.intro}</p>
          </div>
          <div class="proj-grid">
            {projects.map((p) => (
              <a href={withBase(`projects/${p.id}/`)} class="proj-card reveal">
                <div class="thumb">
                  {p.data.thumb && <img src={withBase(p.data.thumb)} alt={p.data.title} />}
                  <span class="tag">{p.data.tag}</span>
                </div>
                <div class="body">
                  <h3>{p.data.title}</h3>
                  <div class="result">{p.data.result}</div>
                  <div class="metrics">
                    {cardMetrics(p.data.metrics).map((m) => (
                      <div>
                        <b>{m.value}</b>
                        <span>{m.label}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <span class="open">Open sheet {p.data.sheet} →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="wrap">
          <div class="contact-grid">
            <div class="reveal">
              <div class="eyebrow">{contact.eyebrow}</div>
              <h2>
                {splitLines(contact.title).map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </h2>
              <p class="lede">{contact.lede}</p>
            </div>
            <div class="contact-links reveal">
              {contact.email && (
                <a href={`mailto:${contact.email}`}>
                  <span>Email</span>
                  <span>{contact.email}</span>
                </a>
              )}
              {contact.phone && (
                <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>
                  <span>Phone</span>
                  <span>{contact.phone}</span>
                </a>
              )}
              {contact.socials.map((l) => (
                <a href={l.url || '#'} target={l.url ? '_blank' : undefined} rel={l.url ? 'noreferrer' : undefined}>
                  <span>{l.label}</span>
                  <span>{l.value}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
        <footer>
          <div class="wrap">
            <span>{site.footerLeft}</span>
            <span>{site.footerRight}</span>
          </div>
        </footer>
      </section>
    </main>
  </div>
</Layout>

<script>
  const els = Array.from(document.querySelectorAll('.reveal'));

  if (!('IntersectionObserver' in window)) {
    els.forEach((e) => e.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    els.forEach((e) => io.observe(e));
  }
</script>
