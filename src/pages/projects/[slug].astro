---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/media';
import { renderMarkdown, renderMarkdownInline } from '../../lib/markdown';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.published);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { slug: p.id },
  }));
}

const { slug } = Astro.props;
const project = await getEntry('projects', slug);
if (!project) throw new Error(`Missing project: ${slug}`);
const p = project.data;

const site = (await getEntry('site', 'site'))!.data;
const contact = (await getEntry('contact', 'contact'))!.data;

const allProjects = (await getCollection('projects', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = allProjects.findIndex((proj) => proj.id === slug);
const next = allProjects[(idx + 1) % allProjects.length]!;

const detailMetrics = p.metrics.filter((m) => m.placement === 'detail');
---

<Layout title={`${p.title} — ${site.brandName}`} description={p.result}>
  <div class="site">
    <nav id="nav">
      <div class="wrap">
        <a href={withBase('')} class="brand">
          <span class="mark"><span>{site.brandInitials}</span></span>
          {site.brandName}
        </a>
        <div class="navlinks">
          <a href={withBase('#home')}>Home</a>
          <a href={withBase('#about')}>About</a>
          <a href={withBase('#skills')}>Skills</a>
          <a href={withBase('#projects')}>Projects</a>
          <a href={withBase('#contact')}>Contact</a>
          {contact.cvUrl ? (
            <a class="cv-btn" href={contact.cvUrl} target="_blank" rel="noreferrer">Get CV</a>
          ) : (
            <a class="cv-btn" href={withBase('#contact')}>Get CV</a>
          )}
        </div>
      </div>
    </nav>

    <div id="project-detail" class="show">
      <div class="pd-header">
        <div class="wrap inner">
          <a href={withBase('#projects')} class="back-btn">← All projects</a>
          <div class="eyebrow">Sheet {p.sheet} — {p.tag}</div>
          <h1>{p.title}</h1>
          <p class="tagline">{p.subtitle}</p>
          {detailMetrics.length > 0 && (
            <div class="pd-metrics">
              {detailMetrics.map((m) => (
                <div>
                  <b>{m.value}</b>
                  <span>{m.label}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="pd-body on-paper">
        <div class="wrap">
          {p.sections.map((section) => (
            <div class="pd-section">
              <div class="pd-num">
                <span class="n">{section.number}</span>
                <h4>{section.heading}</h4>
              </div>
              <div class="pd-content">
                {section.body && <div set:html={renderMarkdown(section.body)} />}
                {section.table && (
                  <table class="datatable">
                    <tr>
                      <th>{section.table.columnOneHeader}</th>
                      <th>{section.table.columnTwoHeader}</th>
                    </tr>
                    {section.table.rows.map((row) => (
                      <tr>
                        <td>{row.label}</td>
                        <td set:html={renderMarkdownInline(row.value)} />
                      </tr>
                    ))}
                  </table>
                )}
                {section.callout && (
                  <div class="callout-box">
                    <b>{section.callout.title}</b>
                    {section.callout.text}
                  </div>
                )}
              </div>
            </div>
          ))}

          <div class="pd-nav-projects">
            <a href={withBase('#projects')}>← All projects</a>
            <a href={withBase(`projects/${next.id}/`)}>Next: {next.data.title} →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
